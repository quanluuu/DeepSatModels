# Inference API settings (api/main.py, api/predictor.py). Copy to .env and edit; never commit .env.
# Model config (MODEL section: architecture sizes, rgb_idx, max_seq_len)
MODEL_CONFIG=configs/PASTIS24/TSViT_DINOv3_fold1.yaml
# Trained TSViT_DINOv3 checkpoint (GitHub Release weights-v1)
CHECKPOINT_PATH=weights/best.pth
# Local snapshot of facebookresearch/dinov3, commit 6876159 (folder with hubconf.py); code only, the backbone weights are in the checkpoint
DINOV3_REPO=weights/dinov3
# Mean max-softmax at or above this gives status OK, below gives UNCERTAIN
CONFIDENCE_THRESHOLD=0.80
# Seconds before /predict gives up and returns status FALLBACK
INFER_TIMEOUT_S=10
# Returned in every response so results can be traced to a model
MODEL_VERSION=tsvit-dinov3-fold1-t9
# CPU threads for torch; 0 keeps the torch default
TORCH_THREADS=0
