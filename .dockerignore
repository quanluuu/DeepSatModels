# allowlist: only what docker/api.Dockerfile and docker/demo.Dockerfile copy reaches the build context
*
!LICENSE.txt
!requirements.txt
!requirements_dinov3.txt
!app/crop_recognition_app.py
!app/demo_core.py
!app/data/demo_patches.npz
!api/
!models/
!utils/
!data/
